{
	"name": "@atmo-dev/kit",
	"version": "0.10.1",
	"description": "The shared UI foundation for Atmo apps.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/flo-bit/atmo-kit.git"
	},
	"packageManager": "pnpm@10.30.1",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm test:unit --run && pnpm test:e2e && pnpm test:package",
		"test:ci": "pnpm test:unit --run --no-file-parallelism && pnpm test:e2e && pnpm test:package",
		"test:e2e": "playwright test",
		"test:package": "pnpm prepack && node --test scripts/test-*-package.mjs",
		"changeset": "changeset",
		"version-packages": "changeset version && pnpm install --lockfile-only --no-frozen-lockfile --ignore-scripts",
		"release": "pnpm prepack && changeset publish"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./at-tags": {
			"types": "./dist/at-tags.d.ts",
			"default": "./dist/at-tags.js"
		},
		"./events": {
			"types": "./dist/events.d.ts",
			"svelte": "./dist/events.js",
			"default": "./dist/events.js"
		},
		"./events-data": {
			"types": "./dist/events-data.d.ts",
			"default": "./dist/events-data.js"
		},
		"./events/editor": {
			"types": "./dist/events-editor.d.ts",
			"default": "./dist/events-editor.js"
		},
		"./grain": {
			"types": "./dist/grain.d.ts",
			"default": "./dist/grain.js"
		},
		"./streamplace": {
			"types": "./dist/streamplace.d.ts",
			"default": "./dist/streamplace.js"
		},
		"./media": {
			"types": "./dist/media.d.ts",
			"default": "./dist/media.js"
		},
		"./urls": {
			"types": "./dist/urls.d.ts",
			"default": "./dist/urls.js"
		},
		"./richtext": {
			"types": "./dist/richtext.d.ts",
			"default": "./dist/richtext.js"
		},
		"./social": {
			"types": "./dist/social.d.ts",
			"default": "./dist/social.js"
		},
		"./lexicons/social.atmo.actor.preferredClient.json": "./dist/lexicons/social.atmo.actor.preferredClient.json",
		"./legal": {
			"types": "./dist/legal.d.ts",
			"default": "./dist/legal.js"
		},
		"./theme.css": "./dist/theme.css"
	},
	"peerDependencies": {
		"maplibre-gl": "^6.16.0",
		"plyr": "^3.8.5",
		"svelte": ">=5.48.0 <6",
		"svelte-maplibre-gl": "^2.2.1",
		"tailwindcss": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"maplibre-gl": {
			"optional": true
		},
		"svelte-maplibre-gl": {
			"optional": true
		},
		"plyr": {
			"optional": true
		}
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@changesets/cli": "^2.31.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/canvas-confetti": "^1.9.0",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"axe-core": "^4.14.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"maplibre-gl": "^6.16.0",
		"playwright": "^1.60.0",
		"plyr": "^3.8.5",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"publint": "^0.3.21",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-maplibre-gl": "^2.2.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"keywords": [
		"svelte"
	],
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@atcute/bluesky-richtext-parser": "^2.1.2",
		"@atcute/lexicons": "^2.1.1",
		"@atcute/tid": "^1.1.4",
		"@fontsource-variable/figtree": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@number-flow/svelte": "^0.4.2",
		"@sketchyicons/svelte": "^0.5.0",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-document": "^3.32.0",
		"@tiptap/extension-hard-break": "^3.32.0",
		"@tiptap/extension-history": "^3.32.0",
		"@tiptap/extension-mention": "^3.32.0",
		"@tiptap/extension-paragraph": "^3.32.0",
		"@tiptap/extension-placeholder": "^3.32.0",
		"@tiptap/extension-text": "^3.32.0",
		"bits-ui": "^2.20.2",
		"canvas-confetti": "^1.9.4",
		"clsx": "^2.1.1",
		"esm-env": "^1.2.2",
		"h3-js": "^4.5.0",
		"hls.js": "^1.7.3",
		"i18n-iso-countries": "^7.14.0",
		"mdast-util-from-markdown": "^2.1.0",
		"mdast-util-gfm-strikethrough": "^2.0.1",
		"micromark-extension-gfm-strikethrough": "^2.1.0",
		"svelte-boring-avatars": "^1.2.6",
		"tailwind-merge": "^3.7.0",
		"valibot": "^1.5.0"
	}
}
